# ── Agent Streetweb — Veille Faits Divers & Culture Urbaine ────
# Copiez ce fichier en `.env` et renseignez vos clés
# ─────────────────────────────────────────────────────────────

# ── Clé API LLM (Gemini / Groq / OpenRouter, compatible OpenAI SDK) ──
# Gemini : https://aistudio.google.com/apikey
# Groq   : https://console.groq.com/keys
# OpenRouter : https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# ── Fallback LLM — Groq ──────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound-mini

# ── Fallback LLM — OpenRouter ───────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ── API Facebook / Meta (Graph API) ────────────────────────────
# • Page Access Token (permanent) : https://developers.facebook.com/tools/access-token/
#   Permissions requises : pages_read_engagement, pages_manage_posts
# • Facebook Page ID : récupérable via /meapr après génération du token
# • Instagram Business Account ID : lié à la page Facebook
FB_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# ── Renouvellement automatique des tokens ─────────────────────
# Identifiants de l'application Facebook (nécessaires pour fb_exchange_token)
# https://developers.facebook.com/apps/ → votre app → Paramètres → Identifiants
FB_APP_ID=
FB_APP_SECRET=

# Nombre de jours entre deux renouvellements automatiques des tokens.
# Les tokens Meta/Threads durent 60 jours — un renouvellement tous les
# 30 jours garantit une marge de sécurité confortable.
# TOKEN_RENEWAL_DAYS=30

# ── Flux RSS (optionnel — sinon ceux de config.py sont utilisés)
# RSS_FEED_URLS=https://www.presse-citron.net/feed/,https://techcrunch.com/category/artificial-intelligence/feed/

# ── Planification (optionnel — défauts : 07:00, 12:00, 17:00, 20:00 heure de Paris) ─
# Format HH:MM (24h), séparés par des virgules
# IMPORTANT : les heures sont TOUJOURS en heure de Paris (gère automatiquement
# l'heure d'été/hiver). Ex: 07:00 = 07:00 du matin à Paris.
# SCHEDULE_TIMES=07:00,12:00,17:00,20:00

# ── Fréquence alternative (si SCHEDULE_TIMES est vide) ───────
# NEWS_INTERVAL_HOURS=2

# ── Port du serveur web ──────────────────────────────────────
# WEB_PORT=5000

# ── Mode test ────────────────────────────────────────────────
# true = exécute un cycle complet (génération + publication) immédiatement au lancement
# (utile pour valider la config sur Render/Railway)
TEST_ON_STARTUP=false

# ── Mode simulation (Dry-Run) ────────────────────────────────
# true  = affiche le post dans la console, ne publie PAS sur Facebook/Instagram
# false = publie réellement sur Facebook et Instagram (comportement normal)
DRY_RUN=false

# ── Notification email (alerte token expiré) ────────────────
# Adresse qui reçoit les alertes
ALERT_EMAIL=yanes75@hotmail.fr

# Activation de l'envoi d'emails (true/false)
SMTP_ENABLED=false

# Configuration SMTP (ex: Gmail, Outlook, etc.)
# Gmail : smtp.gmail.com:587 (nécessite un mot de passe d'application)
# Outlook/Hotmail : smtp-mail.outlook.com:587
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=yanes75@hotmail.fr
SMTP_PASSWORD=
SMTP_FROM_EMAIL=yanes75@hotmail.fr
